# File ini berfungsi sebagai contoh variabel lingkungan (TANPA nilai rahasia asli).
# Salin file ini menjadi `.env.local` lalu isi nilainya.
#
# Aturan: file `.env.local` TIDAK pernah di-commit; `.env.example` di-commit.

# ============================================================
# Supabase Project
# Dapatkan dari dashboard Supabase: Settings > API
# ============================================================

# URL project Supabase (Project URL). Aman dikirim ke browser.
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co

# Anon/public key. Aman di browser karena dilindungi RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Service role key. RAHASIA BESAR.
# Hanya untuk kode server (Route Handler / Server Action). Membypass RLS.
# JANGAN pernah dimasukkan ke NEXT_PUBLIC_* atau dikirim ke frontend.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ============================================================
# Pembayaran
# ============================================================

# Rahasia untuk memvalidasi webhook pembayaran (server-to-server).
PAYMENT_WEBHOOK_SECRET=ganti-dengan-token-acak-panjang

# Mode pembayaran: simulation (MVP) | midtrans | xendit (fase lanjutan).
PAYMENT_MODE=simulation

# ============================================================
# Cron
# ============================================================

# Pengaman endpoint cron (Vercel Cron). HARUS sama dengan nilai yang diatur di Vercel.
CRON_SECRET=ganti-dengan-token-acak-lain
